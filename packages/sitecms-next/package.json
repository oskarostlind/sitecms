{
  "name": "sitecms-next",
  "version": "0.1.0",
  "description": "Typad sitecms-klient för Next.js App Router — hämta innehåll, inlägg och block med cache-taggen \"sitecms\". Inga beroenden.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14.2"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "sitecms",
    "cms",
    "nextjs",
    "headless"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskarostlind/sitecms.git",
    "directory": "packages/sitecms-next"
  },
  "homepage": "https://sitecms-zeta.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/oskarostlind/sitecms/issues"
  },
  "author": "Oskar Östlind",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
