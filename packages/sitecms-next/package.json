{
  "name": "sitecms-next",
  "version": "0.2.1",
  "description": "Koppla en Next.js-sajt till sitecms: typad klient, färdig revalidate-route och CLI för schema-sync. Inga beroenden.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./revalidate": {
      "types": "./dist/revalidate.d.ts",
      "import": "./dist/revalidate.js",
      "default": "./dist/revalidate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14.2"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "sitecms",
    "cms",
    "nextjs",
    "headless",
    "next",
    "app-router"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "next": "^15.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskarostlind/sitecms.git",
    "directory": "packages/sitecms-next"
  },
  "homepage": "https://sitecms-zeta.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/oskarostlind/sitecms/issues"
  },
  "author": "Oskar Östlind",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "sitecms-next": "./dist/cli.js"
  }
}
