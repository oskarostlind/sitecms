{
  "name": "sitecms-next",
  "version": "0.5.0",
  "description": "Koppla en sajt till sitecms med en nyckel och ett kommando (npx sitecms-next init): typad klient, signerad revalidate-route, live-förhandsgranskning i panelen (draft mode, klicka-för-att-redigera), offertförfrågningar med bilagor och CLI för schema-sync. Inga beroenden.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./revalidate": {
      "types": "./dist/revalidate.d.ts",
      "import": "./dist/revalidate.js",
      "default": "./dist/revalidate.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./preview-client": {
      "types": "./dist/preview-client.d.ts",
      "import": "./dist/preview-client.js",
      "default": "./dist/preview-client.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#next-headers": {
      "types": "./dist/next-headers.d.ts",
      "react-server": "./dist/next-headers.server.js",
      "default": "./dist/next-headers.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "sitecms",
    "cms",
    "nextjs",
    "headless",
    "next",
    "app-router",
    "preview",
    "live-preview",
    "draft-mode"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/webhook.test.mjs test/helpers.test.mjs test/cli.test.mjs test/preview.test.mjs test/quote.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "next": "^15.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskarostlind/sitecms.git",
    "directory": "packages/sitecms-next"
  },
  "homepage": "https://sitecms.se/docs",
  "bugs": {
    "url": "https://github.com/oskarostlind/sitecms/issues"
  },
  "author": "Oskar Östlind",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "sitecms-next": "./dist/cli.js"
  }
}
